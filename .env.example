# ---------------------------------------------------------------------------
# LEF Signature   environment variables (names only, no real secrets here)
# Copy this file to `.env.local` and fill in real values for local development.
# NEVER commit `.env.local` or real credentials.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://lefsignature.com

# --- Contact form delivery (server-side only   do NOT prefix with NEXT_PUBLIC) ---
# Wire these up when connecting an email provider to the contact form action.
# Example for a transactional email provider:
CONTACT_EMAIL_TO=inquiries@lefsignature.com
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=
